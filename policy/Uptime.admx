<?xml version="1.0" encoding="utf-8"?>
<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="uptime" namespace="Uptime.Policies" />
  </policyNamespaces>
  <resources minRequiredRevision="1.0" />
  <categories>
    <category name="UptimeCategory" displayName="$(string.UptimeCategory)" />
  </categories>
  <policies>
    <policy name="MaxUptimeDaysPolicy" class="Both" displayName="$(string.MaxUptimeDaysPolicy)" explainText="$(string.MaxUptimeDaysPolicy_Help)" key="Software\Policies\Uptime" valueName="MaxUptimeDays">
      <parentCategory ref="UptimeCategory" />
      <supportedOn ref="SUPPORTED_Windows7" />
      <elements>
        <decimal id="MaxUptimeDaysValue" valueName="MaxUptimeDays" minValue="0" maxValue="365" />
      </elements>
    </policy>
  </policies>
</policyDefinitions>
