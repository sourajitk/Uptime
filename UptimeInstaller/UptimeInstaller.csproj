<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <Version>1.0.1</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>

    <!-- Publishing & Size Optimization Properties -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfContained>true</IncludeNativeLibrariesForSelfContained>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>

    <!-- The installer embeds the published (Release) Uptime.exe for the same runtime -->
    <UptimeAppProject>$(MSBuildThisFileDirectory)..\UptimeTaskbarApp.csproj</UptimeAppProject>
    <UptimeAppExe>$(MSBuildThisFileDirectory)..\bin\Release\net10.0-windows\$(RuntimeIdentifier)\publish\Uptime.exe</UptimeAppExe>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(UptimeAppExe)">
      <Link>Resources\Uptime.exe</Link>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Sources of the main app: a change to any of these makes the embedded Uptime.exe stale. -->
  <ItemGroup>
    <UptimeAppSource Include="$(MSBuildThisFileDirectory)..\*.cs;$(MSBuildThisFileDirectory)..\*.xaml;$(MSBuildThisFileDirectory)..\*.csproj;$(MSBuildThisFileDirectory)..\app.manifest;$(MSBuildThisFileDirectory)..\Assets\**" />
  </ItemGroup>

  <!-- Publish the main app first when its output is missing (e.g. a fresh clone) or older than its sources, so
       `dotnet publish UptimeInstaller` works on its own and never embeds a stale build. In CI the app is published
       (and signed) beforehand, so the output is up to date and this target is skipped. -->
  <Target Name="EnsureUptimeAppPublished" BeforeTargets="CoreCompile" Inputs="@(UptimeAppSource)" Outputs="$(UptimeAppExe)">
    <Message Importance="high" Text="Uptime.exe missing or out of date - publishing $(UptimeAppProject) ($(RuntimeIdentifier))..." />
    <Exec Command="dotnet publish &quot;$(UptimeAppProject)&quot; -c Release -r $(RuntimeIdentifier)" />
  </Target>

</Project>
